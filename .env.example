# Copy to Vercel → Project → Settings → Environment Variables (Production / Preview).
# Local: copy to `.env.local` (never commit `.env.local`).
#
# Edge auth runs from root `proxy.ts` (Next.js 16). Do not add `middleware.ts` alongside it.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for admin bootstrap, CMS mutations, analytics/team APIs.
SUPABASE_SERVICE_ROLE_KEY=

# Required for admin mutations in production (name is historical; set to true when using Supabase persistence).
ALLOW_IN_MEMORY_ADMIN_WRITES=true

# Canonical site origin for absolute links (e.g. QR codes). No trailing slash.
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Optional: bootstrap first owner when staff_profiles row is missing (see lib/admin-auth-config.ts).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Supabase Dashboard → Authentication → URL configuration:
# - Set Site URL to your production origin (e.g. https://yourdomain.com).
# - Add Redirect URLs: production URL, custom domain(s), and Vercel preview URLs if you use email/OAuth redirects.
